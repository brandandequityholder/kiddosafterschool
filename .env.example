# Copy to .env (or set in Vercel → Project → Settings → Environment Variables). All optional.

# Sanity — the site reads the public dataset; no token needed
VITE_SANITY_PROJECT_ID=3p5mllwc
VITE_SANITY_DATASET=production
VITE_SANITY_LIVE=true            # false = serve only the bundled export (src/content/sanity-export.json)

# Analytics
VITE_GA_ID=                      # Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_CLARITY_ID=                 # Microsoft Clarity project ID (optional session recordings)
# Vercel Web Analytics needs no key: enable it in Vercel → Project → Analytics

# Contact form (EmailJS)
VITE_EMAILJS_SERVICE=service_nuvhrhi
VITE_EMAILJS_TEMPLATE=template_porm1gg
VITE_EMAILJS_PUBLIC_KEY=

# Routing: "hash" only for static hosts without rewrites
VITE_ROUTER=browser
